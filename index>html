<script>
  /* =========================================================
     AUTO-SAVE & RESTORE contenteditable progress
     ========================================================= */
  const STORAGE_KEY = 'smy-content-inventory-v1';
  const docBody = document.getElementById('documentBody');
  const savedNote = document.getElementById('savedNote');

  // Assign every contenteditable a stable index for save/restore
  const editables = docBody.querySelectorAll('[contenteditable="true"]');
  editables.forEach((el, i) => el.dataset.fieldIndex = i);

  // Restore saved values
  try {
    const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
    editables.forEach(el => {
      const key = el.dataset.fieldIndex;
      if (saved[key] !== undefined) el.textContent = saved[key];
    });
  } catch (e) { /* ignore */ }

  // Save on input (debounced)
  let saveTimer;
  function saveAll() {
    const data = {};
    editables.forEach(el => { data[el.dataset.fieldIndex] = el.textContent; });
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
      savedNote.classList.add('show');
      clearTimeout(saveTimer);
      saveTimer = setTimeout(() => savedNote.classList.remove('show'), 1200);
    } catch (e) { /* ignore */ }
  }

  docBody.addEventListener('input', function (e) {
    if (e.target.matches('[contenteditable="true"]')) saveAll();
  });

  /* =========================================================
     CLEAR ALL — with confirmation
     ========================================================= */
  function clearAll() {
    if (!confirm('This will clear everything you have typed in this document. Are you sure?')) return;
    editables.forEach(el => { el.textContent = ''; });
    try { localStorage.removeItem(STORAGE_KEY); } catch (e) {}
    saveAll();
  }

