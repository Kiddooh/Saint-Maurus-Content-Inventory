  /* ============ TOOLBAR ============ */
  .toolbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #1a4a8d;
    color: #fff;
    padding: 12px 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(0,0,0,.15);
  }
  .toolbar h1 {
    font-size: 13pt;
    margin: 0;
    font-weight: 600;
    letter-spacing: .3px;
    margin-right: auto;
  }
  .toolbar button {
    border: none;
    background: #d4af37;
    color: #20160a;
    font-weight: 700;
    padding: 10px 20px;
    border-radius: 999px;
    cursor: pointer;
    font-size: 10.5pt;
    font-family: inherit;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: transform .2s, box-shadow .2s, background .2s;
    box-shadow: 0 4px 10px rgba(0,0,0,.15);
  }
  .toolbar button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(0,0,0,.25);
    background: #e8c453;
  }
  .toolbar button.secondary {
    background: rgba(255,255,255,.15);
    color: #fff;
    border: 1px solid rgba(255,255,255,.3);
  }
  .toolbar button.secondary:hover { background: rgba(255,255,255,.28); }

  .toolbar .saved-note {
    font-size: 9pt;
    color: #c9d5e8;
    margin-left: 8px;
    opacity: 0;
    transition: opacity .4s;
  }
  .toolbar .saved-note.show { opacity: 1; }

  /* ============ DOCUMENT SHEET ============ */
  .page {
    width: 210mm;
    min-height: 297mm;
    margin: 24px auto;
    background: #fff;
    padding: 18mm 20mm;
    box-shadow: 0 8px 30px rgba(16,32,64,.15);
    border-radius: 4px;
  }

  /* ============ TYPOGRAPHY ============ */
  h1, h2, h3, h4 {
    font-family: 'Cambria', 'Georgia', serif;
    color: #123566;
    margin: 0 0 10px;
    line-height: 1.3;
  }
  h1 { font-size: 22pt; }
  h2 {
    font-size: 15pt;
    margin-top: 26px;
    padding-bottom: 6px;
    border-bottom: 2px solid #d4af37;
    page-break-after: avoid;
    break-after: avoid;
  }
  h3 {
    font-size: 12.5pt;
    margin-top: 18px;
    color: #1a4a8d;
    page-break-after: avoid;
    break-after: avoid;
  }
  h4 { font-size: 11pt; margin-top: 12px; color: #2f6bc4; }

  p { margin: 0 0 10px; }
  strong { color: #123566; }

  /* ============ COVER ============ */
  .cover {
    text-align: center;
    padding: 40px 10px 30px;
    border-bottom: 3px double #d4af37;
    margin-bottom: 30px;
  }
  .cover .cross {
    font-size: 42pt;
    color: #d4af37;
    line-height: 1;
    margin-bottom: 8px;
  }
  .cover h1 { font-size: 26pt; margin-bottom: 6px; }
  .cover .sub { font-size: 13pt; color: #1a4a8d; font-weight: 600; margin-bottom: 24px; }
  .cover .meta {
    display: inline-block;
    text-align: left;
    font-size: 10.5pt;
    background: #f4f6fb;
    padding: 14px 22px;
    border-radius: 6px;
    border-left: 4px solid #1a4a8d;
  }
  .cover .meta div { margin-bottom: 4px; }
  .cover .meta span { display: inline-block; min-width: 130px; font-weight: 600; color: #123566; }

  /* ============ TABLES ============ */
  table {
    width: 100%;
    border-collapse: collapse;
    margin: 10px 0 18px;
    font-size: 10pt;
    page-break-inside: avoid;
    break-inside: avoid;
  }
  thead { background: #1a4a8d; color: #fff; }
  thead th {
    padding: 8px 10px;
    text-align: left;
    font-weight: 600;
    font-size: 9.5pt;
    letter-spacing: .3px;
    border: 1px solid #123566;
  }
  tbody td {
    padding: 8px 10px;
    border: 1px solid #c8d0dc;
    vertical-align: top;
  }
  tbody tr:nth-child(even) td { background: #f7f9fc; }

  /* Editable cells */
  [contenteditable="true"] {
    outline: none;
    cursor: text;
    border-radius: 3px;
    padding: 1px 3px;
    transition: background .15s, box-shadow .15s;
  }
  [contenteditable="true"]:hover { background: #fff8e1; }
  [contenteditable="true"]:focus {
    background: #fff;
    box-shadow: 0 0 0 2px #d4af37;
  }

  /* Inline blanks */
  .blank {
    display: inline-block;
    min-width: 160px;
    border-bottom: 1px dotted #8a94a6;
    padding: 0 4px 1px;
    color: #1f2430;
  }
  .blank.long { min-width: 340px; }
  .blank.short { min-width: 90px; }

  /* Checklist */
  .checklist { list-style: none; padding-left: 0; }
  .checklist li {
    padding: 5px 0 5px 30px;
    position: relative;
    border-bottom: 1px dashed #dde2ea;
    font-size: 10.5pt;
  }
  .checklist li::before {
    content: '';
    position: absolute;
    left: 0; top: 6px;
    width: 16px; height: 16px;
    border: 1.5px solid #1a4a8d;
    border-radius: 3px;
    background: #fff;
  }

  /* Note boxes */
  .note {
    background: #fff8e1;
    border-left: 4px solid #d4af37;
    padding: 12px 16px;
    margin: 14px 0;
    font-size: 10pt;
    border-radius: 0 6px 6px 0;
  }
  .note strong { color: #8a6d00; }

  /* Section numbers */
  .sec-num {
    display: inline-block;
    background: #1a4a8d;
    color: #fff;
    width: 26px; height: 26px;
    border-radius: 50%;
    text-align: center;
    line-height: 26px;
    font-size: 12pt;
    font-weight: 700;
    margin-right: 10px;
    font-family: 'Cambria', serif;
  }

  /* Field-line style for long-form */
  .field {
    margin: 10px 0 16px;
  }
  .field label {
    display: block;
    font-weight: 600;
    color: #123566;
    margin-bottom: 4px;
    font-size: 10.5pt;
  }
  .field .input {
    display: block;
    min-height: 24px;
    border: 1px solid #c8d0dc;
    border-radius: 4px;
    padding: 6px 10px;
    background: #fbfcfe;
    font-size: 10.5pt;
  }
  .field .input.tall { min-height: 60px; }

  /* Signature block */
  .signatures {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-top: 40px;
    page-break-inside: avoid;
  }
  .sig-line {
    border-top: 1.5px solid #1a4a8d;
    padding-top: 6px;
    font-size: 9.5pt;
    color: #4a5468;
  }
  .sig-line strong { display: block; margin-bottom: 2px; color: #123566; }

  /* Page breaks */
  .page-break { page-break-before: always; break-before: page; }

  /* ============ PRINT ============ */
  @media print {
    @page {
      size: A4;
      margin: 16mm 14mm;
    }
    html, body {
      background: #fff !important;
      font-size: 10.5pt;
    }
    .toolbar { display: none !important; }
    .page {
      width: auto;
      min-height: 0;
      margin: 0;
      padding: 0;
